APP_NAME=EstateLead
PORT=5000
NODE_ENV=development

JWT_SECRET=your_super_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=8h
SESSION_SECRET=your_session_cookie_secret_key_here

DB_TYPE=sqlite

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estatelead_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=estatelead_db

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=400
ENQUIRY_RATE_LIMIT_MAX=15

ENABLE_DATA_MASKING=true
ENABLE_SECURITY_AUDIT=true
